    %% ─────────────────────────────────────────────────────────────────
    style BOOKS  fill:#e8f4e8,stroke:#2d7a2d,stroke-width:2px
    style F4562  fill:#fff8e1,stroke:#f9a825,stroke-width:2px
    style F8825  fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style F1065  fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style K1     fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style XF_AUDIT fill:#f5f5f5,stroke:#757575,stroke-width:1px,stroke-dasharray:5

    style P1_ZERO fill:#ffcdd2,stroke:#b71c1c,stroke-width:2px
    style K1_B1  fill:#ffcdd2,stroke:#b71c1c,stroke-width:2px
    style K1_B14 fill:#ffcdd2,stroke:#b71c1c,stroke-width:2px
    style SCHK_2 fill:#c8e6c9,stroke:#1b5e20,stroke-width:2px
    style K1_B2  fill:#c8e6c9,stroke:#1b5e20,stroke-width:2px
    style F8_NET fill:#c8e6c9,stroke:#1b5e20,stroke-width:2px
